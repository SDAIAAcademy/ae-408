# Without keys every lab runs on supplied inputs and the scripted stand-in (no network).
# To call hosted models, set HT_PROVIDER=hosted and the keys below (labs/README.md lists the calls).
# HT_PROVIDER=hosted
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
HT_VLM_OPEN=google/gemma-4-26b-a4b-it:free
HT_VLM_HOSTED=nvidia/nemotron-3.5-super-vl:free
HT_ASR_A=whisper-large-v3
HT_ASR_B=whisper-large-v3-turbo
HT_TTS_AR=canopylabs/orpheus-arabic-saudi
HT_TTS_EN=canopylabs/orpheus-v1-english
# 1 shrinks every run to save calls and time
HT_QUICK=0
